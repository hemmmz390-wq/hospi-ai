# Semua variabel di bawah ini opsional. Salin file ini menjadi .env
# dan isi yang dibutuhkan. Jangan pernah meng-commit file .env.

# Gemini untuk klasifikasi pesan tamu & transkripsi suara.
# Tanpa key, dipakai pengklasifikasi berbasis aturan.
GEMINI_API_KEY=""

# Redis (Upstash) untuk sinkron antar perangkat di Vercel.
# Terisi otomatis bila Upstash disambungkan lewat dashboard Vercel.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Port server lokal (bawaan 3000).
# PORT=3000
